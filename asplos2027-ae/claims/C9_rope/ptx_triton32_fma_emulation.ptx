// Transcribed verbatim from the paper, Listing 2 (left column, "Triton 3.2").
// NOT captured by re-running Triton 3.2: current TritonParse requires triton > 3.3.1
// and cannot instrument 3.2 at all.  The provenance of this file is the paper text.
//
// Semantics: out = in_rope1 * cos_rope - in_rope2 * sin_rope, where every product is
// materialised as a rounded bf16 value by an fma with a zero addend, and the
// subtraction is a third fma against the constant -1.0.
//
//   0x8000 = -0.0f16   (zero addend, so fma degenerates to a rounded multiply)
//   0xbf80 = -1.0bf16  (multiplier that turns the third fma into a subtraction)

{ .reg .b16 c;    // temp1 = in_rope1 * cos_rope
mov.b16 c, 0x8000U;
fma.rn.bf16 %temp1, %in_rope1, %cos_rope, c; }

{ .reg .b16 c;   // temp2 = in_rope2 * sin_rope
mov.b16 c, 0x8000U;
fma.rn.bf16 %temp2, %in_rope2, %sin_rope, c; }

{ .reg .b16 c;         // result = temp1 - temp2
mov.b16 c, 0xbf80U;
fma.rn.bf16 %result, %temp2, c, %temp1; }
