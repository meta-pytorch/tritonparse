{
  "name": "tritonparse-website",
  "private": true,
  "version": "0.5.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:single": "tsc -b && vite build && node scripts/inline-html.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:unit": "node --test \"e2e/monaco-ir/unit/*.test.ts\"",
    "test:e2e-monaco": "node e2e/monaco-ir/run.mjs",
    "test:perf": "node e2e/monaco-ir/perf.mjs",
    "test:worker": "node e2e/monaco-ir/worker-probe.mjs"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@monaco-editor/react": "^4.7.0",
    "clp-ffi-js": "^0.7.0-beta.3",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "^4.14.1",
    "react-syntax-highlighter": "^16.1.1"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "^3.4.14"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1"
  }
}
